<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vexelray.scheduler</groupId>
    <artifactId>vexelray-scheduler</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>VexelRay Scheduler</name>
    <description>The VexelRay scheduler.</description>

    <modules>
        <!-- The desktop application, generated from vexelray-framework-template's vexel-desktop template. -->
        <module>vexelray-scheduler-app</module>
        <!-- The interval constraint solver: JDK-only, so it builds and tests with no window and no stack. -->
        <module>vexelray-scheduler-solver</module>
        <!-- Lean proofs about the solver, in src/main/lean; its test runs lake, so the proofs gate the build. -->
        <module>vexelray-scheduler-proofs</module>
    </modules>

    <!-- What every module builds against. The stack's versions live here so the modules cannot disagree about
         them; each module still names its own dependencies and plugins. -->
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- The stack this is built against, as one version: vexelray-bom's, imported below, which fixes the version
             of every library in the stack, so no dependency in this build names one. Moving to a newer stack is this
             line. -->
        <vexelray-bom.version>0.2.1-SNAPSHOT</vexelray-bom.version>
        <!-- A BOM manages dependencies and not plugins, so the stack's two build plugins keep a version of their own:
             vexelray-gui's icons plugin and vexelray-build's (both in the app module). -->
        <vexelray-gui.version>0.2.1-SNAPSHOT</vexelray-gui.version>
        <vexelray-build.version>0.2.1-SNAPSHOT</vexelray-build.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- The stack's versions (vexelray-framework's vexelray-bom). Each library also carries its own
                 native-image metadata and flags, so a native build inherits what the libraries it depends on need,
                 and this project writes none of it. -->
            <dependency>
                <groupId>dev.vexelray.framework</groupId>
                <artifactId>vexelray-bom</artifactId>
                <version>${vexelray-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <!-- On Linux the build goes to target-linux/, not target/: the Windows host and a Linux VM build the same checkout
             (a shared folder), and each keeps its own output beside the other's instead of overwriting it. -->
        <profile>
            <id>linux-build-output</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <directory>${project.basedir}/target-linux</directory>
            </build>
        </profile>
    </profiles>
</project>
