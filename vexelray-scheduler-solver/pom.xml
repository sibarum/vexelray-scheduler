    <artifactId>vexelray-scheduler-solver</artifactId>

    <name>vexelray-scheduler-solver</name>
    <description>
        An interval constraint solver. JDK-only: no graphics, no stack, no reflection, so it is tested without a
        window and compiles into the application's native image as it is.
    </description>

